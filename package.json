{
  "name": "ario-scripts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx server/index.ts\"",
